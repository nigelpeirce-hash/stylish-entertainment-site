# Supabase Database Connection
# Copy this file to .env.local and fill in your actual values
# Get your connection string from: Supabase Dashboard → Settings → Database → Connection string (URI)
#
# Use Transaction mode (port 6543) to avoid "max clients reached" errors:
# Host: aws-0-REGION.pooler.supabase.com (or aws-1-eu-west-1.pooler.supabase.com etc.)
# Port: 6543 (not 5432 – Session mode has a low connection limit)
# User: postgres.PROJECT_REF (e.g. postgres.abcdefghijklmnop)
# Add: ?pgbouncer=true&sslmode=require (or &sslmode=no-verify for local)

DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# NextAuth Configuration (dev server runs on port 3001: npm run dev)
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Site URL (for production, use your actual domain)
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Resend (transactional email)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_DEFAULT_FROM="STYLISH Entertainment <info@stylishentertainment.co.uk>"
CONTACT_FORM_EMAIL="info@stylishentertainment.co.uk"

# Deposit invoice (optional – for “please pay” email)
# DEPOSIT_INVOICE_BANK_NAME="Stylish Entertainment"
# DEPOSIT_INVOICE_SORT_CODE="20-05-06"
# DEPOSIT_INVOICE_ACCOUNT_NUMBER="83312038"
# DEPOSIT_INVOICE_IBAN="GB39 BARC2005 0683312038"
# DEPOSIT_INVOICE_SWIFT="BARCGB22"

# Google Maps (admin: Enquiry drawer map embed, DJ Worksheet mileage)
# Enable "Maps Embed API" and "Distance Matrix API" in Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Google reCAPTCHA v3 (contact / contact-us forms – spam protection)
# Get both keys from: https://www.google.com/recaptcha/admin (create a v3 site)
# Add localhost as allowed domain for local testing.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LcFcFosAAAAAHocYD0Gp9ynqt7ipOQFrqbvjLtl"
# RECAPTCHA_SECRET_KEY="6LcFcFosAAAAALgMHf8nkL-TLmQONgaeseTacpXf"

# YouTube (optional – video gallery /galleries/videos)
# Enable "YouTube Data API v3" in Google Cloud Console.
# Add your live domain to HTTP referrer restrictions for production.
# NEXT_PUBLIC_YOUTUBE_API_KEY="AIzaSy..."
# NEXT_PUBLIC_YOUTUBE_CHANNEL_ID="@stylishentertainment937"

# Post-wedding magic email: Google Review + Instagram (client)
# NEXT_PUBLIC_GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=..."
# Instagram link is hardcoded to https://www.instagram.com/stylishentertainment/

# Cloudinary (optional – for client portal PDF/Word music-list uploads)
# CLOUDINARY_CLOUD_NAME="drtwveoqo"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
