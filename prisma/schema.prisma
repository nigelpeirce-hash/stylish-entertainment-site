generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuditLog {
  id          String   @id
  bookingId   String
  action      String
  description String
  performedBy String?
  createdAt   DateTime @default(now())
  Booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model Booking {
  id                          String                   @id
  userId                      String?
  name                        String
  email                       String
  phoneAreaCode               String?
  phoneNumber                 String?
  eventType                   String                   @default("wedding")
  eventDate                   DateTime
  venueName                   String
  venueContact                String?
  venueAddress                String?
  venueAddress2               String?
  venueTown                   String?
  venueCounty                 String?
  venuePostcode               String?
  venuePhoneAreaCode          String?
  venuePhoneNumber            String?
  djArrivalTime               String?
  djStartTime                 String?
  djFinishTime                String?
  djSetupLocation             String?
  djParking                   String?
  soundLimiter                Boolean?
  numberOfGuests              Int?
  services                    String[]
  message                     String?
  budget                      String?
  status                      String                   @default("pending")
  contactPreference           String?
  finalBalance                String?
  paymentMethod               String?
  paymentPayerName            String?
  termsAccepted               Boolean                  @default(false)
  termsAcceptedAt             DateTime?
  completedTasks              String[]
  emailsSent                  Json?
  lastEmailSentAt             DateTime?
  musicNotesToDJ              String?
  musicNotesToStylish         String?
  firstDance                  String?
  lastSong                    String?
  musicDislikes               String?
  musicRequests               String?
  musicFileUrl                String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime
  preferredDJ                 String?
  upsellItems                 String[]
  priority                    String                   @default("medium")
  adminNotes                  String?
  authorizedSenders           String[]
  bookingReference            String?                  @unique
  conflictResolvedAt          DateTime?
  conflictStatus              String?
  depositReceived             Boolean?                 @default(false)
  depositReceivedManual       Boolean?                 @default(false)
  djWorksheetApproved         Boolean?                 @default(false)
  djWorksheetApprovedManual   Boolean?                 @default(false)
  feeBreakdown                Json?
  finalDetailsConfirmed       Boolean?                 @default(false)
  finalDetailsConfirmedManual Boolean?                 @default(false)
  flaggedFor                  String?
  handoffNote                 String?
  handoffStatus               String?
  isTechReady                 Boolean?                 @default(false)
  overrideReason              String?
  purgeAt                     DateTime?
  rescuedAt                   DateTime?
  selectedTemplate            String?
  talentStatus                Json?
  taxInclusive                Boolean?                 @default(true)
  taxRate                     Float?                   @default(20)
  venueFingerprint            String?
  assignedTo                  assigned_member?
  AuditLog                    AuditLog[]
  User                        User?                    @relation(fields: [userId], references: [id])
  staffAssignments            BookingStaffAssignment[]
  Cart                        Cart[]
  CommsLog                    CommsLog[]
  emailThreads                EmailThread[]
  HireOrder                   HireOrder[]
  NewEnquiry                  NewEnquiry[]
  Note                        Note[]
  Task                        Task[]

  @@index([bookingReference])
  @@index([email])
  @@index([eventDate])
  @@index([eventDate, venuePostcode])
  @@index([status])
  @@index([userId])
}

model BookingStaffAssignment {
  id                    String        @id
  bookingId             String
  staffId               String
  role                  String
  agreedFee             Float
  status                String        @default("held")
  confirmationEmailSent Boolean       @default(false)
  confirmationSentAt    DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime
  cancellationReason    String?
  cancelledAt           DateTime?
  briefStatus           String?       @default("pending")
  acknowledgedAt        DateTime?     @db.Timestamp(6)
  briefToken            String?
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff                 FreelanceCrew @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([staffId])
  @@index([status])
}

model Cart {
  id        String     @id
  userId    String?
  sessionId String?
  status    String     @default("active")
  bookingId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Booking   Booking?   @relation(fields: [bookingId], references: [id])
  User      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem  CartItem[]

  @@index([sessionId])
  @@index([status])
  @@index([userId])
}

model CartItem {
  id         String   @id
  cartId     String
  hireItemId String
  quantity   Int      @default(1)
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  HireItem   HireItem @relation(fields: [hireItemId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([hireItemId])
}

model CommsLog {
  id                String   @id
  bookingId         String?
  platform          String
  direction         String
  phoneNumber       String?
  email             String?
  contactName       String?
  message           String?
  mediaUrl          String?
  mediaType         String?
  mediaFileName     String?
  whatsappMessageId String?
  whatsappTimestamp String?
  sentByUserId      String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
  Booking           Booking? @relation(fields: [bookingId], references: [id])
  User              User?    @relation(fields: [sentByUserId], references: [id])

  @@index([bookingId])
  @@index([createdAt])
  @@index([email])
  @@index([phoneNumber])
  @@index([platform])
  @@index([whatsappMessageId])
}

model DJ {
  id             String   @id
  name           String
  slug           String?  @unique
  bio            String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  mixcloudUrl    String?
  youtubeEmbed   String?

  @@index([displayOrder])
  @@index([isActive])
  @@index([slug])
}

model Email {
  id           String      @id
  threadId     String
  messageId    String?     @unique
  inReplyTo    String?
  subject      String
  fromEmail    String
  fromName     String?
  toEmail      String
  toName       String?
  cc           String[]
  bcc          String[]
  textContent  String?
  htmlContent  String?
  attachments  Json?
  direction    String
  isRead       Boolean     @default(false)
  isStarred    Boolean     @default(false)
  sentByUserId String?
  inboxId      String
  receivedAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())
  EmailInbox   EmailInbox  @relation(fields: [inboxId], references: [id])
  User         User?       @relation(fields: [sentByUserId], references: [id])
  EmailThread  EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([fromEmail])
  @@index([inboxId])
  @@index([messageId])
  @@index([receivedAt])
  @@index([threadId])
  @@index([toEmail])
}

model EmailInbox {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  isActive      Boolean       @default(true)
  imapHost      String
  imapPort      Int           @default(993)
  imapSecure    Boolean       @default(true)
  imapUsername  String
  imapPassword  String
  smtpHost      String?
  smtpPort      Int?          @default(587)
  smtpSecure    Boolean       @default(true)
  smtpUsername  String?
  smtpPassword  String?
  syncEnabled   Boolean       @default(true)
  lastSyncedAt  DateTime?
  syncInterval  Int           @default(5)
  assignedUsers String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Email         Email[]
  EmailThread   EmailThread[]
  EmailFolder   EmailFolder[]

  @@index([email])
  @@index([isActive])
  @@index([assignedUsers], type: Gin)
}

model EmailTemplate {
  id          String   @id
  name        String
  subject     String
  bodyHtml    String
  bodyText    String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdById String?
  User        User?    @relation(fields: [createdById], references: [id])

  @@index([category])
  @@index([isActive])
}

model EmailThread {
  id            String       @id
  subject       String
  fromEmail     String
  fromName      String?
  toEmail       String
  bookingId     String?
  userId        String?
  source        String       @default("imap")
  isRead        Boolean      @default(false)
  isStarred     Boolean      @default(false)
  isArchived    Boolean      @default(false)
  lastMessageAt DateTime     @default(now())
  inboxId       String
  folderId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Email         Email[]
  Booking       Booking?     @relation(fields: [bookingId], references: [id])
  EmailInbox    EmailInbox   @relation(fields: [inboxId], references: [id])
  EmailFolder   EmailFolder? @relation(fields: [folderId], references: [id])
  User          User?        @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([fromEmail])
  @@index([inboxId])
  @@index([folderId])
  @@index([lastMessageAt])
  @@index([userId])
}

model EmailFolder {
  id           String        @id @default(uuid())
  inboxId      String
  name         String
  fullPath     String // e.g., "QUOTES/DJ quotes/Better Proposal Quotes"
  parentId     String? // For nested folders
  delimiter    String        @default("/") // IMAP folder delimiter
  attributes   Json? // IMAP folder attributes (e.g., \NoInferiors, \HasChildren)
  unreadCount  Int           @default(0)
  totalCount   Int           @default(0)
  lastSyncedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  EmailInbox   EmailInbox    @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  EmailThread  EmailThread[]
  parent       EmailFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     EmailFolder[] @relation("FolderHierarchy")

  @@unique([inboxId, fullPath])
  @@index([inboxId])
  @@index([parentId])
  @@index([fullPath])
}

model FormSubmission {
  id        String   @id
  userId    String?
  formType  String
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([formType])
  @@index([userId])
}

model FreelanceCrew {
  id                     String                   @id
  name                   String
  email                  String?
  phone                  String?
  roles                  String[]
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  BookingStaffAssignment BookingStaffAssignment[]

  @@index([isActive])
  @@index([name])
}

model HireItem {
  id             String          @id
  name           String
  description    String?
  price          Float           @default(50.00)
  stockAvailable Int             @default(0)
  imageUrl       String?
  category       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  seoDescription String?
  seoTitle       String?
  slug           String?         @unique
  CartItem       CartItem[]
  HireOrderItem  HireOrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([slug])
}

model HireOrder {
  id                                 String          @id
  orderNumber                        String          @unique
  customerName                       String
  customerEmail                      String
  customerPhone                      String?
  customerAddress                    String?
  eventDate                          DateTime?
  eventType                          String?
  venueName                          String?
  venueAddress                       String?
  status                             String          @default("pending")
  totalAmount                        Float
  notes                              String?
  userId                             String?
  bookingId                          String?
  createdAt                          DateTime        @default(now())
  updatedAt                          DateTime
  confirmedAt                        DateTime?
  confirmedById                      String?
  Booking                            Booking?        @relation(fields: [bookingId], references: [id])
  User_HireOrder_confirmedByIdToUser User?           @relation("HireOrder_confirmedByIdToUser", fields: [confirmedById], references: [id])
  User_HireOrder_userIdToUser        User?           @relation("HireOrder_userIdToUser", fields: [userId], references: [id])
  HireOrderItem                      HireOrderItem[]

  @@index([createdAt])
  @@index([orderNumber])
  @@index([status])
  @@index([userId])
}

model HireOrderItem {
  id         String    @id
  orderId    String
  hireItemId String
  quantity   Int
  price      Float
  itemName   String
  createdAt  DateTime  @default(now())
  HireItem   HireItem  @relation(fields: [hireItemId], references: [id], onDelete: Cascade)
  HireOrder  HireOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([hireItemId])
  @@index([orderId])
}

model Musician {
  id             String   @id
  name           String
  slug           String?  @unique
  bio            String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  instrument     String?
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  youtubeEmbed   String?

  @@index([displayOrder])
  @@index([instrument])
  @@index([isActive])
  @@index([slug])
}

model NewEnquiry {
  id                    String    @id
  name                  String
  email                 String
  phoneAreaCode         String?
  phoneNumber           String?
  eventDate             DateTime
  venuePostcode         String
  venueName             String?
  isConflict            Boolean   @default(false)
  originalBookingId     String?
  conflictDetectedAt    DateTime?
  conflictResolved      Boolean   @default(false)
  status                String    @default("new")
  reviewedAt            DateTime?
  reviewedBy            String?
  firstTouchEmailSent   Boolean   @default(false)
  firstTouchEmailSentAt DateTime?
  notificationSent      Boolean   @default(false)
  notificationSentAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  Booking               Booking?  @relation(fields: [originalBookingId], references: [id])

  @@index([createdAt])
  @@index([email])
  @@index([eventDate, venuePostcode])
  @@index([isConflict])
  @@index([status])
}

model Note {
  id                          String   @id
  content                     String
  bookingId                   String?
  userId                      String?
  createdById                 String
  isPinned                    Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  Booking                     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  User_Note_createdByIdToUser User     @relation("Note_createdByIdToUser", fields: [createdById], references: [id])
  User_Note_userIdToUser      User?    @relation("Note_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
  @@index([createdById])
  @@index([userId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Staff_Settings {
  id                  String   @id @db.Uuid
  name                String   @unique
  created_at          DateTime @default(now())
  updated_at          DateTime
  notificationEnabled Boolean  @default(true)
  phoneNumber         String?
  pushUserKey         String?

  @@index([name], map: "idx_staff_settings_name")
}

model Task {
  id                           String    @id
  title                        String
  description                  String?
  bookingId                    String?
  assignedToId                 String?
  createdById                  String
  status                       String    @default("pending")
  priority                     String    @default("medium")
  dueDate                      DateTime?
  completedAt                  DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime
  User_Task_assignedToIdToUser User?     @relation("Task_assignedToIdToUser", fields: [assignedToId], references: [id])
  Booking                      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  User_Task_createdByIdToUser  User      @relation("Task_createdByIdToUser", fields: [createdById], references: [id])

  @@index([assignedToId])
  @@index([bookingId])
  @@index([dueDate])
  @@index([status])
}

model User {
  id                                      String           @id
  name                                    String?
  email                                   String           @unique
  emailVerified                           DateTime?
  password                                String?
  image                                   String?
  phone                                   String?
  address                                 String?
  role                                    String           @default("client")
  createdAt                               DateTime         @default(now())
  updatedAt                               DateTime
  invitedAt                               DateTime?
  Account                                 Account[]
  Booking                                 Booking[]
  Cart                                    Cart[]
  CommsLog                                CommsLog[]
  Email                                   Email[]
  EmailTemplate                           EmailTemplate[]
  EmailThread                             EmailThread[]
  FormSubmission                          FormSubmission[]
  HireOrder_HireOrder_confirmedByIdToUser HireOrder[]      @relation("HireOrder_confirmedByIdToUser")
  HireOrder_HireOrder_userIdToUser        HireOrder[]      @relation("HireOrder_userIdToUser")
  Note_Note_createdByIdToUser             Note[]           @relation("Note_createdByIdToUser")
  Note_Note_userIdToUser                  Note[]           @relation("Note_userIdToUser")
  Session                                 Session[]
  Task_Task_assignedToIdToUser            Task[]           @relation("Task_assignedToIdToUser")
  Task_Task_createdByIdToUser             Task[]           @relation("Task_createdByIdToUser")

  @@index([email])
}

model VenueAsset {
  id                 String   @id
  venueName          String
  year               Int
  pdfUrl             String
  cloudinaryPublicId String?
  fileName           String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  @@unique([venueName, year])
  @@index([isActive])
  @@index([venueName])
  @@index([year])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum AssignedMember {
  ali
  husband
  none
}

enum assigned_member {
  ali
  husband
  none
}
