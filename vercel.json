{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "stylishweddingdisco.co.uk" }],
      "dest": "https://www.stylishentertainment.co.uk/$1",
      "status": 308
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.stylishweddingdisco.co.uk" }],
      "dest": "https://www.stylishentertainment.co.uk/$1",
      "status": 308
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "stylishweddingdisco.co.uk" }],
      "destination": "https://www.stylishentertainment.co.uk/$1",
      "statusCode": 308
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.stylishweddingdisco.co.uk" }],
      "destination": "https://www.stylishentertainment.co.uk/$1",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-journey",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/monday-brief",
      "schedule": "0 8 * * 1"
    }
  ],
  "buildCommand": "next build",
  "framework": "nextjs",
  "installCommand": "npm install"
}
